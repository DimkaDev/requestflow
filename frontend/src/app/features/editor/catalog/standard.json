{
  "pack": "standard",
  "version": 1,
  "title": "Standard",
  "license": {
    "source": "own",
    "notes": "FlowTrace core flow architecture blocks."
  },
  "blocks": [
    {
      "id": "standard.start",
      "name": "Start / Client",
      "category": "Flow Control",
      "nodeType": "source",
      "icon": "lib:globe",
      "tint": "var(--node-source)",
      "defaultLabel": "Client Request",
      "keyPattern": "client",
      "ports": { "in": 0, "out": "many" },
      "role": "start",
      "defaultProps": { "shape": "card", "showCounter": true },
      "tags": ["standard", "ingress", "client", "start"],
      "snippetHint": "Start a new trace here when a user request enters your system."
    },
    {
      "id": "standard.service",
      "name": "Service",
      "category": "Compute",
      "nodeType": "service",
      "icon": "lib:server",
      "tint": "var(--node-service)",
      "defaultLabel": "Backend Service",
      "keyPattern": "service",
      "ports": { "in": "many", "out": "many" },
      "role": "normal",
      "defaultProps": { "shape": "card", "holdTimeMs": 350 },
      "tags": ["standard", "service", "microservice", "api"],
      "snippetHint": "Emit a checkpoint when the service starts processing the request."
    },
    {
      "id": "standard.decision",
      "name": "Decision (if)",
      "category": "Flow Control",
      "nodeType": "decision",
      "icon": "lib:git-branch",
      "tint": "var(--node-decision)",
      "defaultLabel": "Route Condition?",
      "keyPattern": "if-condition",
      "ports": { "in": "many", "out": "many" },
      "role": "decision",
      "defaultProps": { "shape": "diamond" },
      "tags": ["standard", "decision", "branch", "condition", "if"],
      "snippetHint": "Branch requests along weighted or labeled outgoing connections."
    },
    {
      "id": "standard.parallel",
      "name": "Parallel Split",
      "category": "Flow Control",
      "nodeType": "decision",
      "icon": "lib:git-branch",
      "tint": "var(--node-queue)",
      "defaultLabel": "Parallel Fanout",
      "keyPattern": "parallel-split",
      "ports": { "in": 1, "out": "many" },
      "role": "decision",
      "defaultProps": { "shape": "card" },
      "tags": ["standard", "parallel", "fanout", "split"],
      "snippetHint": "Fan out asynchronous sub-branches from a single trace."
    },
    {
      "id": "standard.join",
      "name": "Join / Merge",
      "category": "Flow Control",
      "nodeType": "service",
      "icon": "lib:layers",
      "tint": "var(--node-service)",
      "defaultLabel": "Join Barrier",
      "keyPattern": "join-merge",
      "ports": { "in": "many", "out": 1 },
      "role": "normal",
      "defaultProps": { "shape": "pill" },
      "tags": ["standard", "join", "merge", "aggregator"],
      "snippetHint": "Converge multiple upstream branches into a single downstream step."
    },
    {
      "id": "standard.datastore",
      "name": "Datastore",
      "category": "Data & State",
      "nodeType": "datastore",
      "icon": "lib:database",
      "tint": "var(--node-datastore)",
      "defaultLabel": "Primary Database",
      "keyPattern": "db",
      "ports": { "in": "many", "out": "many" },
      "role": "normal",
      "defaultProps": { "shape": "card" },
      "tags": ["standard", "database", "sql", "storage"],
      "snippetHint": "Send a checkpoint around database reads or writes."
    },
    {
      "id": "standard.queue",
      "name": "Queue",
      "category": "Messaging",
      "nodeType": "queue",
      "icon": "lib:layers",
      "tint": "var(--node-queue)",
      "defaultLabel": "Event Queue",
      "keyPattern": "queue",
      "ports": { "in": "many", "out": "many" },
      "role": "normal",
      "defaultProps": { "shape": "card" },
      "tags": ["standard", "queue", "buffer", "async"],
      "snippetHint": "Emit a checkpoint when enqueueing or polling messages."
    },
    {
      "id": "standard.cache",
      "name": "Cache",
      "category": "Data & State",
      "nodeType": "datastore",
      "icon": "lib:bolt",
      "tint": "var(--node-queue)",
      "defaultLabel": "In-Memory Cache",
      "keyPattern": "cache",
      "ports": { "in": "many", "out": "many" },
      "role": "normal",
      "defaultProps": { "shape": "pill", "holdTimeMs": 120 },
      "tags": ["standard", "cache", "kv", "fast"],
      "snippetHint": "Record cache hit or miss checkpoints."
    },
    {
      "id": "standard.external",
      "name": "External API",
      "category": "Integration",
      "nodeType": "external",
      "icon": "lib:globe",
      "tint": "var(--node-external)",
      "defaultLabel": "Third-Party API",
      "keyPattern": "external-api",
      "ports": { "in": "many", "out": "many" },
      "role": "normal",
      "defaultProps": { "shape": "card" },
      "tags": ["standard", "external", "webhook", "partner"],
      "snippetHint": "Track outbound HTTP calls to external providers."
    },
    {
      "id": "standard.end",
      "name": "End",
      "category": "Flow Control",
      "nodeType": "end",
      "icon": "lib:check-circle",
      "tint": "var(--node-end)",
      "defaultLabel": "Response Complete",
      "keyPattern": "end",
      "ports": { "in": "many", "out": 0 },
      "role": "end",
      "defaultProps": { "shape": "pill" },
      "tags": ["standard", "end", "complete", "terminal"],
      "snippetHint": "Send type='end' when the request finishes."
    },
    {
      "id": "standard.note",
      "name": "Note (Annotation)",
      "category": "Annotation",
      "nodeType": "external",
      "icon": "lib:note",
      "tint": "var(--node-external)",
      "defaultLabel": "Architecture Note",
      "keyPattern": "note",
      "ports": { "in": 0, "out": 0 },
      "role": "normal",
      "defaultProps": { "shape": "card", "showCounter": false },
      "tags": ["standard", "note", "comment", "annotation"],
      "snippetHint": "Non-flow documentation note on the canvas."
    }
  ]
}
