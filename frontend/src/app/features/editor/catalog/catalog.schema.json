{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FlowTrace Block Catalog Pack",
  "type": "object",
  "required": ["pack", "version", "title", "license", "blocks"],
  "properties": {
    "pack": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "license": {
      "type": "object",
      "required": ["source", "notes"],
      "properties": {
        "source": { "type": "string" },
        "notes": { "type": "string" }
      }
    },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "category",
          "nodeType",
          "icon",
          "tint",
          "defaultLabel",
          "keyPattern",
          "ports",
          "role",
          "tags",
          "snippetHint"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-_.]+$" },
          "name": { "type": "string", "minLength": 1 },
          "category": { "type": "string", "minLength": 1 },
          "nodeType": {
            "type": "string",
            "enum": [
              "source",
              "datastore",
              "service",
              "gateway",
              "db",
              "cache",
              "queue",
              "external",
              "worker",
              "client",
              "decision",
              "parallel",
              "join",
              "end",
              "note",
              "group"
            ]
          },
          "icon": { "type": "string", "minLength": 1 },
          "tint": { "type": "string", "minLength": 1 },
          "defaultLabel": { "type": "string", "minLength": 1 },
          "keyPattern": { "type": "string", "pattern": "^[a-z0-9-_.]{1,64}$" },
          "ports": {
            "type": "object",
            "required": ["in", "out"],
            "properties": {
              "in": { "oneOf": [{ "type": "integer", "minimum": 0 }, { "const": "many" }] },
              "out": { "oneOf": [{ "type": "integer", "minimum": 0 }, { "const": "many" }] }
            }
          },
          "role": {
            "type": "string",
            "enum": ["normal", "start", "end", "decision", "success", "failure", "abandon"]
          },
          "defaultProps": { "type": "object" },
          "tags": {
            "type": "array",
            "items": { "type": "string" }
          },
          "snippetHint": { "type": "string" }
        }
      }
    }
  }
}
