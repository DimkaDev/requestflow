{
  "pack": "shop",
  "version": 1,
  "title": "Shop",
  "license": {
    "source": "own",
    "notes": "FlowTrace Live Shop e-commerce blocks with customer entity and cart carry support."
  },
  "blocks": [
    {
      "id": "shop.visit",
      "name": "Visit",
      "category": "Storefront",
      "nodeType": "source",
      "icon": "lib:store",
      "tint": "var(--node-source)",
      "defaultLabel": "Storefront Visit",
      "keyPattern": "visit",
      "ports": { "in": 0, "out": "many" },
      "role": "start",
      "defaultProps": { "groupId": "zone-store" },
      "tags": ["shop", "storefront", "visit", "landing"],
      "snippetHint": "Send when a shopper lands on the storefront."
    },
    {
      "id": "shop.browse",
      "name": "Browse",
      "category": "Storefront",
      "nodeType": "service",
      "icon": "lib:compass",
      "tint": "var(--node-service)",
      "defaultLabel": "Browse Catalog",
      "keyPattern": "browse",
      "ports": { "in": "many", "out": "many" },
      "role": "normal",
      "defaultProps": { "groupId": "zone-store" },
      "tags": ["shop", "browse", "catalog", "collection"],
      "snippetHint": "Send when the visitor views a category or search page."
    },
    {
      "id": "shop.product",
      "name": "Product",
      "category": "Storefront",
      "nodeType": "service",
      "icon": "lib:tag",
      "tint": "var(--node-service)",
      "defaultLabel": "Product Detail",
      "keyPattern": "product",
      "ports": { "in": "many", "out": "many" },
      "role": "normal",
      "defaultProps": { "groupId": "zone-store" },
      "tags": ["shop", "product", "pdp", "item"],
      "snippetHint": "Send when a shopper inspects a specific product page."
    },
    {
      "id": "shop.cart",
      "name": "Cart",
      "category": "Checkout",
      "nodeType": "service",
      "icon": "lib:shopping-cart",
      "tint": "var(--node-decision)",
      "defaultLabel": "Cart",
      "keyPattern": "cart",
      "ports": { "in": "many", "out": "many" },
      "role": "normal",
      "defaultProps": { "idleAbandonMinutes": 30 },
      "tags": ["shop", "checkout", "cart", "bag"],
      "snippetHint": "Send a checkpoint with carry.op='add' when the visitor changes the cart."
    },
    {
      "id": "shop.checkout",
      "name": "Checkout",
      "category": "Checkout",
      "nodeType": "service",
      "icon": "lib:user-check",
      "tint": "var(--node-service)",
      "defaultLabel": "Checkout Step",
      "keyPattern": "checkout",
      "ports": { "in": "many", "out": "many" },
      "role": "normal",
      "defaultProps": { "idleAbandonMinutes": 15, "groupId": "zone-checkout" },
      "tags": ["shop", "checkout", "address", "shipping"],
      "snippetHint": "Send when the customer enters checkout details."
    },
    {
      "id": "shop.payment",
      "name": "Payment",
      "category": "Checkout",
      "nodeType": "decision",
      "icon": "lib:credit-card",
      "tint": "var(--node-decision)",
      "defaultLabel": "Payment Gateway",
      "keyPattern": "payment",
      "ports": { "in": "many", "out": "many" },
      "role": "decision",
      "defaultProps": { "shape": "diamond", "groupId": "zone-checkout" },
      "tags": ["shop", "payment", "stripe", "checkout"],
      "snippetHint": "Send when payment authorization is submitted."
    },
    {
      "id": "shop.paid",
      "name": "Paid ✓",
      "category": "Outcome",
      "nodeType": "end",
      "icon": "lib:check-circle",
      "tint": "var(--status-ok)",
      "defaultLabel": "Order Paid",
      "keyPattern": "paid",
      "ports": { "in": "many", "out": "many" },
      "role": "success",
      "defaultProps": { "shape": "pill" },
      "tags": ["shop", "paid", "success", "order", "revenue"],
      "snippetHint": "Send type='complete' when payment succeeds to record revenue."
    },
    {
      "id": "shop.payment-failed",
      "name": "Payment Failed ✕",
      "category": "Outcome",
      "nodeType": "end",
      "icon": "lib:alert-circle",
      "tint": "var(--status-error)",
      "defaultLabel": "Payment Failed",
      "keyPattern": "payment-failed",
      "ports": { "in": "many", "out": "many" },
      "role": "failure",
      "defaultProps": { "shape": "pill" },
      "tags": ["shop", "failed", "declined", "error"],
      "snippetHint": "Send type='fail' when the card is declined or gateway errors."
    },
    {
      "id": "shop.abandoned",
      "name": "Abandoned",
      "category": "Outcome",
      "nodeType": "end",
      "icon": "lib:x-circle",
      "tint": "var(--status-warn)",
      "defaultLabel": "Cart Abandoned",
      "keyPattern": "abandoned",
      "ports": { "in": "many", "out": 0 },
      "role": "abandon",
      "defaultProps": { "shape": "pill" },
      "tags": ["shop", "abandoned", "drop-off", "idle"],
      "snippetHint": "Triggered on session idle timeout or explicit cart exit."
    },
    {
      "id": "shop.shipping",
      "name": "Shipping",
      "category": "Fulfillment",
      "nodeType": "service",
      "icon": "lib:truck",
      "tint": "var(--node-queue)",
      "defaultLabel": "Order Shipped",
      "keyPattern": "shipping",
      "ports": { "in": "many", "out": "many" },
      "role": "normal",
      "defaultProps": {},
      "tags": ["shop", "shipping", "fulfillment", "delivery"],
      "snippetHint": "Send when fulfillment dispatches the package."
    },
    {
      "id": "shop.refund",
      "name": "Refund",
      "category": "Fulfillment",
      "nodeType": "end",
      "icon": "lib:rotate-ccw",
      "tint": "var(--status-warn)",
      "defaultLabel": "Order Refunded",
      "keyPattern": "refund",
      "ports": { "in": "many", "out": 0 },
      "role": "failure",
      "defaultProps": {},
      "tags": ["shop", "refund", "return"],
      "snippetHint": "Send when a refund webhook is received."
    }
  ]
}
